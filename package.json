{
    "name": "steam-api-fetcher",
    "version": "1.0.0",
    "description": "A TypeScript library for fetching Steam user inventories and player data with proxy support and retry mechanisms",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "test": "ts-node test/test.ts",
        "clean": "rimraf dist",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "lint": "npm run format:check"
    },
    "keywords": [
        "steam",
        "inventory",
        "steam-api",
        "steam-inventory",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.13.2",
        "https-proxy-agent": "^7.0.6",
        "steamid": "^2.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": ""
    },
    "engines": {
        "node": ">=14.0.0"
    }
}
